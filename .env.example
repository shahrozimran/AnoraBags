# Set a unique random password of at least 24 characters. There is no default.
ADMIN_KEY=
# Only true behind a trusted ingress that overwrites x-forwarded-for.
TRUST_PROXY=false
# Optional canonical public origin when the reverse proxy rewrites Host.
# APP_ORIGIN=https://your-domain.example
# Use durable private storage. Do not commit live customer/order/session data.
# ANORA_DATA_DIR=/absolute/private/anora-data

# --- Order notification emails (Nodemailer + Gmail) ---
# Your Gmail address that will send AND receive order notifications.
GMAIL_USER=anorabags10@gmail.com
# A 16-character Gmail App Password (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the account.)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
